rules_version = '2';

// Security rules for SFSR-REMS.
//
// Both the public Web Portal and the office-LAN Internal Management System hit
// this same database, so these rules are the only thing separating a buyer from
// staff functions. The Internal app being "local" is not a security boundary —
// anyone can point a browser at Firestore directly.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function roleOf() {
      return signedIn() ? profile().role : '';
    }

    function isStaff() {
      return roleOf() in ['sales', 'documentation', 'admin'];
    }

    function isAdmin() {
      return roleOf() == 'admin';
    }

    // Fields a buyer must never be able to set or change on their own record.
    // Without this, a buyer could self-promote by writing role: 'admin'.
    function keepsPrivilegedFields() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.accountType == resource.data.accountType
          && request.resource.data.active == resource.data.active;
    }

    // --- users -----------------------------------------------------------

    match /users/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);

      // Self-registration: a new account may only ever be created as a buyer.
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'buyer'
                    && request.resource.data.accountType == 'initial'
                    && request.resource.data.active == true;

      // Buyers may edit their own profile but not their role or account type.
      allow update: if (signedIn() && request.auth.uid == userId && keepsPrivilegedFields())
                    || isStaff();

      allow delete: if isAdmin();
    }

    // --- units -----------------------------------------------------------

    match /units/{unitId} {
      // Prospective buyers browse the catalogue without an account, which the
      // study requires, so reads are public.
      allow read: if true;

      // The ONLY unit change a buyer may make is placing an available unit on
      // hold as part of the reservation transaction. Everything else — marking
      // a unit sold, releasing a hold, editing the price — is staff-only.
      //
      // Without this narrowing, any signed-in buyer could flip any unit to
      // 'available' and reserve a property that was already sold.
      function buyerPlacingHold() {
        return resource.data.status == 'available'
            && request.resource.data.status == 'on_hold'
            && request.resource.data.heldBy is string
            && request.resource.data.price == resource.data.price
            && request.resource.data.unitNo == resource.data.unitNo;
      }

      // The mirror image: a buyer withdrawing their own reservation puts the
      // unit back on the market.
      //
      // The final clause is what makes this safe. Allowing any signed-in user
      // to move a unit from 'on_hold' to 'available' would hand them a way to
      // release someone else's hold and take the unit — so the reservation
      // named in heldBy is read, and it must belong to the caller.
      function buyerReleasingOwnHold() {
        return resource.data.status == 'on_hold'
            && request.resource.data.status == 'available'
            && request.resource.data.heldBy == null
            && request.resource.data.price == resource.data.price
            && request.resource.data.unitNo == resource.data.unitNo
            && resource.data.heldBy is string
            && get(/databases/$(database)/documents/reservations/$(resource.data.heldBy)).data.buyerUid == request.auth.uid;
      }

      allow update: if isStaff()
                    || (signedIn() && buyerPlacingHold())
                    || (signedIn() && buyerReleasingOwnHold());

      allow create, delete: if isStaff();
    }

    // --- reservations ----------------------------------------------------

    match /reservations/{reservationId} {
      allow read: if isStaff()
                  || (signedIn() && resource.data.buyerUid == request.auth.uid);

      // A buyer may only file a reservation in their own name.
      allow create: if isStaff()
                    || (signedIn()
                        && request.resource.data.buyerUid == request.auth.uid
                        && request.resource.data.status == 'pending');

      // Approval and rejection are staff-only judgements on an application.
      //
      // Cancellation is not a judgement — it is the buyer withdrawing, so they
      // may do it to their own reservation while it is still open. The status
      // is pinned to 'cancelled' and the identifying fields are frozen, so this
      // cannot be used to approve oneself or to re-point a reservation at a
      // different unit or buyer.
      function buyerCancellingOwn() {
        return resource.data.buyerUid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'under_review']
            && request.resource.data.unitId == resource.data.unitId
            && request.resource.data.buyerUid == resource.data.buyerUid
            && request.resource.data.buyer == resource.data.buyer;
      }

      allow update: if isStaff() || (signedIn() && buyerCancellingOwn());
      allow delete: if isStaff();
    }

    // --- documents -------------------------------------------------------

    match /documents/{documentId} {
      allow read: if isStaff()
                  || (signedIn() && resource.data.buyerUid == request.auth.uid);

      allow create: if isStaff()
                    || (signedIn()
                        && request.resource.data.buyerUid == request.auth.uid
                        && request.resource.data.status == 'pending');

      // Buyers can re-run OCR on their own upload, but only staff may approve
      // or reject a document.
      allow update: if isStaff()
                    || (signedIn()
                        && resource.data.buyerUid == request.auth.uid
                        && request.resource.data.status == resource.data.status);

      allow delete: if isStaff();
    }

    // --- tripping requests -----------------------------------------------

    match /trippingRequests/{trippingId} {
      // The only collection an anonymous visitor may write to. A site visit is
      // requested *before* anyone registers, so demanding an account here would
      // turn away the leads the feature exists to capture.
      //
      // With no identity to check, the rules validate the shape instead: an
      // exact field set (so no one can smuggle in extra data), types, lengths,
      // and a status pinned to 'pending' so a visitor cannot file a booking
      // that is already confirmed. This constrains what can be written, not how
      // often — see the note in SETUP.md about rate limiting.
      function validTripping() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'projectName', 'fullName', 'email', 'mobile', 'preferredDate',
                 'preferredSlot', 'partySize', 'message', 'status',
                 'requestedByUid', 'createdAt'
               ])
            && d.keys().hasAll([
                 'projectName', 'fullName', 'email', 'mobile', 'preferredDate',
                 'preferredSlot', 'partySize', 'status', 'requestedByUid',
                 'createdAt'
               ])
            && d.status == 'pending'
            && d.fullName is string && d.fullName.size() > 1
               && d.fullName.size() <= 120
            && d.email is string && d.email.size() <= 200
               && d.email.matches('^[^@]+@[^@]+[.][^@]+$')
            && d.mobile is string && d.mobile.size() >= 7
               && d.mobile.size() <= 20
            && d.projectName is string && d.projectName.size() <= 120
            && d.preferredDate is string
               && d.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.preferredSlot is string && d.preferredSlot.size() <= 40
            && d.partySize is int && d.partySize >= 1 && d.partySize <= 10
            && (!('message' in d)
                || (d.message is string && d.message.size() <= 500))
            // A signed-in visitor may only stamp their own uid on it.
            && (d.requestedByUid == null
                || d.requestedByUid == request.auth.uid);
      }

      allow create: if validTripping();

      // Leads are commercially sensitive: staff see all, a signed-in visitor
      // sees only the ones they filed, and nobody else reads them at all.
      allow read: if isStaff()
                  || (signedIn()
                      && resource.data.requestedByUid == request.auth.uid);

      allow update, delete: if isStaff();
    }

    // --- audit trail -----------------------------------------------------

    match /auditLogs/{logId} {
      allow read: if isStaff();
      // Append-only: an audit trail that can be edited is not an audit trail.
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
