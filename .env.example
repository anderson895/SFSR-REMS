# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.
#
# Vite only exposes variables prefixed with VITE_ to the browser.

# --- Firebase (project: sfsr-rems) ---
# These are safe to ship to the browser by design; access is controlled by
# firestore.rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sfsr-rems.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sfsr-rems
VITE_FIREBASE_STORAGE_BUCKET=sfsr-rems.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Local development ---
# Set to true to point both apps at the local Firebase emulators instead of the
# real project. Development then costs NO Firestore quota, which matters on the
# free Spark plan (50,000 reads per day).
#
#   Terminal 1:  npm run emulators
#   Terminal 2:  npm run dev:portal
#
# Leave blank or false to use the real sfsr-rems project.
VITE_USE_EMULATOR=

# --- Cloudinary (unsigned uploads) ---
# Find the cloud name at Cloudinary Console -> Dashboard -> "Cloud name".
# Unsigned uploads need ONLY these two values.
#
# WARNING: never put the Cloudinary API Secret in this file or in any VITE_
# variable. Anything with a VITE_ prefix is bundled into the JavaScript that
# ships to every visitor's browser. The API Secret is not needed for unsigned
# uploads and must stay server-side only.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=sfsr_uploads
